<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules (Android 12+): database is backed up to the cloud and
    transferred between devices, so users keep their tasks.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>